# volume do postgres criado pelo docker-compose
db_data/

# rede de segurança: nenhum .env deve ser versionado em nenhum módulo
.env
.env.*
!.env.example

# O lockfile da raiz faz o Next inferir a raiz do monorepo como workspace
# root e quebra o build do frontend na Vercel. Cada modulo tem o seu.
/bun.lock
