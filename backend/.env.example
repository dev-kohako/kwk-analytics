# --- Servidor ---
PORT=4000

# --- Banco ---
DATABASE_URL=
PRISMA_CLIENT_ENGINE_TYPE=binary

# --- Cache (opcional) ---
# Sem REDIS_URL o cache é in-memory, por processo.
# Com REDIS_URL o resultado passa a ser compartilhado entre réplicas.
# REDIS_URL=redis://localhost:6379

# --- IA nos insights (opcional) ---
# A API funciona sem nada disto: os insights determinísticos sempre respondem.
# Basta UMA das chaves abaixo — o provedor, a URL e o modelo são inferidos dela.
#
#   Groq        GROQ_API_KEY=...        gratuito, o mais rápido    console.groq.com/keys
#   Gemini      GEMINI_API_KEY=...      free tier generoso         aistudio.google.com/apikey
#   OpenRouter  OPENROUTER_API_KEY=...  modelos :free              openrouter.ai/keys
#   Ollama      AI_PROVIDER=ollama      100% local, sem chave      ollama.com
#   DeepSeek    DEEPSEEK_API_KEY=...    pago, barato
#
# GROQ_API_KEY=
#
# Para fixar o provedor ou trocar o modelo padrão:
# AI_PROVIDER=groq          # groq | gemini | openrouter | ollama | deepseek
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=              # só para proxy/gateway próprio
# AI_TIMEOUT_MS=12000
# AI_MAX_TOKENS=900
# AI_ENABLED=true           # false desliga a IA mantendo a chave configurada

# --- Contas (obrigatório em produção) ---
JWT_SECRET=
APP_URL=http://localhost:3000

# --- E-mail para redefinição de senha (opcional) ---
# Sem SMTP o link é impresso no console — funciona em desenvolvimento,
# não em produção. Gmail exige senha de app, não a senha da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="KWK Analytics <nao-responda@seudominio.com>"

# --- Cobrança via Stripe (opcional) ---
# Sem chave, os planos aparecem mas o checkout recusa com mensagem clara.
# Os price IDs vêm do painel do Stripe, um por plano pago.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
